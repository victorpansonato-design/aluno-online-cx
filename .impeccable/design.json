         "html": "<button class=\"ds-button\">Continuar</button>",
         "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-family:\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:12.5px;font-weight:600;line-height:1.45;text-align:center;cursor:pointer;max-width:100%;transition:background .18s,color .18s,transform .18s}.ds-button:disabled{opacity:.48;cursor:not-allowed}.ds-button:active:not(:disabled){transform:translateY(1px)}.ds-button:focus-visible{outline:3px solid #507fd8;outline-offset:4px;border-radius:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-button{background:var(--primary,#153977);color:var(--surface,#fff)}.ds-button:hover{background:var(--primary-hover,#0e2c60)}"
